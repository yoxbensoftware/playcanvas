PORT=3001
FILESYSTEM_URL=http://localhost:3002
UPLOADS_DIR=./uploads
FRAMES_DIR=./uploads/frames

# Processor: mock | colmap | lumaai
# mock     = geliştirme için sahte pipeline (GPU gerekmez)
# colmap   = yerel COLMAP + 3DGS (CUDA GPU gerekli, Linux/WSL önerilir)
# lumaai   = Luma AI bulut API (LUMA_API_KEY gerekli)
PROCESSOR=mock

# Luma AI kullanacaksan buraya API key gir
# LUMA_API_KEY=your_key_here
