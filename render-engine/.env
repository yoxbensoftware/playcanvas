PORT=3001
FILESYSTEM_URL=http://localhost:3002
UPLOADS_DIR=./uploads
FRAMES_DIR=./uploads/frames

# Processor: mock | colmap | lumaai
# mock     = geliştirme için sahte pipeline (GPU gerekmez)
# colmap   = yerel COLMAP + 3DGS (CUDA GPU gerekli, Linux/WSL önerilir)
# lumaai   = Luma AI bulut API (LUMA_API_KEY gerekli)
PROCESSOR=colmap

# Luma AI API key (PROCESSOR=lumaai için)
# Almak için: https://lumalabs.ai/dashboard/api
LUMA_API_KEY=

# Yerel COLMAP + nerfstudio yolları (PROCESSOR=colmap için)
COLMAP_EXE=C:\Users\ozgen\OneDrive\Masaüstü\playcanvas\colmap-x64-windows-cuda\bin\colmap.exe
NS_PROCESS_DATA=C:\Users\ozgen\miniconda3\envs\nerfstudio\Scripts\ns-process-data.exe
NS_TRAIN=C:\Users\ozgen\miniconda3\envs\nerfstudio\Scripts\ns-train.exe
NS_EXPORT=C:\Users\ozgen\miniconda3\envs\nerfstudio\Scripts\ns-export.exe

# Eğitim iterasyon sayısı (daha fazla = daha iyi kalite ama daha yavaş)
NS_TRAIN_ITERATIONS_NERFACTO=3000
NS_TRAIN_ITERATIONS_SPLAT=5000
NS_EXPORT_NUM_POINTS=500000

# Luma AI kullanacaksan buraya API key gir
# LUMA_API_KEY=your_key_here
